PORT=4000
DB_PATH=./transcend.db

# Local dev (against contracts/scripts/deploy-local.js on localhost:8545) --
# leave RPC_URL/CHAIN_ID unset and the backend auto-reads
# backend/deployment.local.json for contract addresses.

# For Arc Testnet, set all of these:
# RPC_URL=https://rpc.testnet.arc.io
# CHAIN_ID=5042002
# BUSINESS_REGISTRY_ADDRESS=0x...
# INVESTMENT_POOL_ADDRESS=0x...

INDEXER_POLL_MS=3000
